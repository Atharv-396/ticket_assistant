# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model for generating decisions
# gemini-1.5-flash is fast and cost-effective
GEMINI_MODEL=gemini-1.5-flash

# Gemini embedding model
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Random secret used to sign JWTs — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_random_secret_here

# JWT signing algorithm (default HS256)
JWT_ALGORITHM=HS256

# Token expiry in minutes (default 60)
JWT_EXPIRE_MINUTES=60

# SQLite database file path (relative to project root)
DATABASE_URL=sqlite:///./support_assistant.db

# Path to HR knowledge-base .md files
# Default resolves to candidate_pack/knowledge_base/ relative to project root
# KB_DIR=candidate_pack/knowledge_base

# Path to persisted embeddings JSON
# EMBEDDINGS_PATH=data/embeddings.json

# Number of chunks retrieved per query (default 4)
# RETRIEVAL_TOP_K=4

# Streamlit → FastAPI base URL (used by streamlit_app.py)
# API_BASE_URL=http://localhost:8000
